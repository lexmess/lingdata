    <TIER ANNOTATOR="lexmess" LINGUISTIC_TYPE_REF="default-lt" TIER_ID="gestComment@rfs2006f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2810"
                TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>встречается в течение всего видео</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2811"
                TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>мне показалось это как такое "взяли себя в руки"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2812"
                TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE/>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2813"
                TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>мне кажется, это движение при смехе, но, возможно, оно нарочитое из-за нервов</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2867"
                TIME_SLOT_REF1="ts558" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>пришлось сделать длинным, чтобы руки на место вернулись</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2512"
                TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>тут отметила только голову,т.к, мне кажется, движение рук здесь уже просто нервозность, либо продолжение предыдущего жеста</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2513"
                TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>движения глаз и рук к размеченным жестам не относятся, встречаются почти всё видео</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2590"
                TIME_SLOT_REF1="ts778" TIME_SLOT_REF2="ts788">
                <ANNOTATION_VALUE>тут (да и до этого) размечаю головк из-за движения глаз</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2591"
                TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts835">
                <ANNOTATION_VALUE>глаза не размечала, т.к, на мой взгляд, это уже другой жест (воспоминание, возможно)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2592"
                TIME_SLOT_REF1="ts853" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>игнорирую движения рук, т.к это просто  продолжительный жест нервозности. движения глаз тоже не разметила, т.к все это время здесь идет воспоминание</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2888"
                TIME_SLOT_REF1="ts1087" TIME_SLOT_REF2="ts1093">
                <ANNOTATION_VALUE>движение плеч здесь - смех, поэтому не размечала</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2649"
                TIME_SLOT_REF1="ts1137" TIME_SLOT_REF2="ts1144">
                <ANNOTATION_VALUE>опять же не стала размечать глаза, т.к много есть моментов думанья, где глаза поднимаются вверх</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2688"
                TIME_SLOT_REF1="ts1260" TIME_SLOT_REF2="ts1269">
                <ANNOTATION_VALUE>разметила от начала жеста до возвращения в исходную позицию. движение головы - другой жест</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2689"
                TIME_SLOT_REF1="ts1303" TIME_SLOT_REF2="ts1322">
                <ANNOTATION_VALUE>глаза вниз - нервозность на протяжении долгого времени, другие жесты показались важнее</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2690"
                TIME_SLOT_REF1="ts1332" TIME_SLOT_REF2="ts1352">
                <ANNOTATION_VALUE>опять же,движения глаз будут продолжаться, но размечу их только тут, т.к потом есть более значимые жесты</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2814"
                TIME_SLOT_REF1="ts1546" TIME_SLOT_REF2="ts1565">
                <ANNOTATION_VALUE>В моей разметке, возможно, встречается задумчивость как адаптор и прагматическое "задумалась". Как мне кажется, это такие два вида думанья, условно пассивное и активное</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2815"
                TIME_SLOT_REF1="ts1571" TIME_SLOT_REF2="ts1578">
                <ANNOTATION_VALUE>Тут это как завершение думанья</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2868"
                TIME_SLOT_REF1="ts1589" TIME_SLOT_REF2="ts1596">
                <ANNOTATION_VALUE>тут есть движение глаз, но к жесту оно не имеет отношения</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2816"
                TIME_SLOT_REF1="ts1602" TIME_SLOT_REF2="ts1614">
                <ANNOTATION_VALUE>Опять же про движение глаз, оно везде, т.к идет процесс вспоминания и думанья, но при этом к размеченным жестам это не относится</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2817"
                TIME_SLOT_REF1="ts1623" TIME_SLOT_REF2="ts1632">
                <ANNOTATION_VALUE>Может, это нервное, но, по-моему, это не жест, просто физиологическая потребность</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2818"
                TIME_SLOT_REF1="ts1651" TIME_SLOT_REF2="ts1665">
                <ANNOTATION_VALUE>нужно было отметить жест до возвращения рук в начальное положение, так что не отметила вот это задумчивое движение глаз</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2819"
                TIME_SLOT_REF1="ts1687" TIME_SLOT_REF2="ts1700">
                <ANNOTATION_VALUE>опять глаза</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2820"
                TIME_SLOT_REF1="ts1763" TIME_SLOT_REF2="ts1773">
                <ANNOTATION_VALUE>есть маленький кивок, но он про выделение "вот"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2821"
                TIME_SLOT_REF1="ts1780" TIME_SLOT_REF2="ts1789">
                <ANNOTATION_VALUE>другие движения к жесту не относятся</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2840"
                TIME_SLOT_REF1="ts1799" TIME_SLOT_REF2="ts1815">
                <ANNOTATION_VALUE>движения рук - нервное, "нет" - в плане в целом речь идет о каком-то отрицании (дарить не надо, собирать не будет)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2841"
                TIME_SLOT_REF1="ts1859" TIME_SLOT_REF2="ts1868">
                <ANNOTATION_VALUE>мне кажется, здесь это не изобразительный жест, т.к имеется в виду скорее подчеркивание качества, чем собственно указание размера</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2889"
                TIME_SLOT_REF1="ts1920" TIME_SLOT_REF2="ts1936">
                <ANNOTATION_VALUE>жест заканчивается позже, но хотелось разметить следующий тоже</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2982"
                TIME_SLOT_REF1="ts2158" TIME_SLOT_REF2="ts2171">
                <ANNOTATION_VALUE>отметила как изобразительный, т.к, мне кажется, это похоже на демонстрацию какого-то листа бумаги/списка. жест длинный, т.к возвращаем руку на место для следующего жеста</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
